{
	"info": {
		"_postman_id": "1da46fc3-c7cf-46c2-98a7-eb73cf5fe45f",
		"name": "robusta",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "1046035"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{access_token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "generate token",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const res = pm.response.json();",
							"if (res.access_token) {",
							"    pm.collectionVariables.set('access_token', res.access_token);",
							"    console.log('access_token stored');",
							"} else {",
							"    console.log('no access_token in response', res);",
							"}"
						]
					}
				}
			],
			"request": {
				"auth": {
					"type": "noauth"
				},
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"grant_type\": \"password\",\n    \"client_id\": \"{{client_id}}\",\n    \"client_secret\": \"{{client_secret}}\",\n    \"username\": \"{{username}}\",\n    \"password\": \"{{password}}\",\n    \"scope\": \"\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/oauth/token",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"oauth",
						"token"
					]
				},
				"description": "Exchange the seeded password-grant client credentials + admin login for a bearer token. Passport 12+ generates a UUID client_id and a hashed secret, so set the `client_id` / `client_secret` collection variables to the values printed once by `db:seed` (OauthClientsTableSeeder). The test script stores `access_token` for the other requests."
			},
			"response": []
		},
		{
			"name": "get available seats of trip",
			"protocolProfileBehavior": {
				"disableBodyPruning": true
			},
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/v1/trip/seats?trip_id=1&from_city_id=1&to_city_id=5",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"trip",
						"seats"
					],
					"query": [
						{
							"key": "trip_id",
							"value": "1"
						},
						{
							"key": "from_city_id",
							"value": "1"
						},
						{
							"key": "to_city_id",
							"value": "5"
						}
					]
				},
				"description": "Returns the available seat ids for the given leg (from_city_id inclusive, to_city_id exclusive)."
			},
			"response": []
		},
		{
			"name": "book seat",
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"trip_id\": 1,\n    \"seat_id\": 1,\n    \"from_city_id\": 1,\n    \"to_city_id\": 3\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/api/v1/trip/seat/book",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"trip",
						"seat",
						"book"
					]
				},
				"description": "Books the seat on the given leg. Returns okay=false with HTTP 422 when the seat is not available for that leg."
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost",
			"type": "string"
		},
		{
			"key": "client_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "client_secret",
			"value": "",
			"type": "string"
		},
		{
			"key": "username",
			"value": "admin@admin.com",
			"type": "string"
		},
		{
			"key": "password",
			"value": "123456",
			"type": "string"
		},
		{
			"key": "access_token",
			"value": "",
			"type": "string"
		}
	]
}
